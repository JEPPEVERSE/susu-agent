# ==============================
# 应用配置
# ==============================

APP_ENV=development
APP_NAME=susu-agent
APP_HOST=127.0.0.1
APP_PORT=8000


# ==============================
# OpenAI
# ==============================

# 必填：不要在此处填写真实 API Key
OPENAI_API_KEY=

# OpenAI provider 的进程级回退模型
OPENAI_DEFAULT_MODEL=gpt-5.4-mini

# 使用 DeepSeek 时填写；不要在示例文件中保存真实 Key
DEEPSEEK_API_KEY=

# 第三方模型不使用 OpenAI tracing
OPENAI_AGENTS_DISABLE_TRACING=true

# 上传教材并创建 Vector Store 后填写
OPENAI_VECTOR_STORE_ID=


# ==============================
# 数据库
# ==============================

# 本地开发可以使用 SQLite
DATABASE_URL=sqlite:///data/app.db

# Agent 多轮会话数据库
SESSION_DB_PATH=data/sessions.db


# ==============================
# 日志
# ==============================

# DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# 是否将日志写入文件
LOG_TO_FILE=true

# 日志文件存放目录
LOG_DIR=logs

# 文件日志默认记录 DEBUG；终端仍由 LOG_LEVEL 控制
LOG_FILE_LEVEL=DEBUG

# 单个日志文件达到该大小后轮转；保留最近的备份文件数量
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=7


# ==============================
# Agent 配置
# ==============================

# v0.2 Agent 共用的显式模型。切回 OpenAI 时可改为 gpt-5.4-mini。
# DeepSeek 的后台结构化结果会自动使用“JSON 文本 + 本地 Pydantic 校验”。
AGENT_MODEL=litellm/deepseek/deepseek-chat

# 可选的 Agent 级覆盖；留空时使用 AGENT_MODEL。
TUTOR_MODEL=
MATH_SOLUTION_MODEL=
TEACHING_STATE_UPDATER_MODEL=
SOLUTION_VERIFIER_MODEL=
TEACHING_PLANNER_MODEL=
TEACHING_EXECUTOR_MODEL=
STUDENT_MODEL_SUMMARIZER_MODEL=

# 验证失败后允许求解 Agent 修订的最大次数
MAX_SOLUTION_REVISIONS=2

# 当前长期学生模型标识
STUDENT_ID=default_student

AGENT_MAX_TURNS=10
COURSE_SUBJECT=math
COURSE_GRADE=high_school_1
