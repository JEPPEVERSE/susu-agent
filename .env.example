# ==============================
# 应用配置
# ==============================

APP_ENV=development
APP_NAME=susu-agent
APP_HOST=127.0.0.1
APP_PORT=8000


# ==============================
# OpenAI
# ==============================

# 必填：不要在此处填写真实 API Key
OPENAI_API_KEY=

# 可选：不填写时使用代码中的默认模型
OPENAI_MODEL=

# 上传教材并创建 Vector Store 后填写
OPENAI_VECTOR_STORE_ID=


# ==============================
# 数据库
# ==============================

# 本地开发可以使用 SQLite
DATABASE_URL=sqlite:///data/app.db

# Agent 多轮会话数据库
SESSION_DB_PATH=data/sessions.db


# ==============================
# 日志
# ==============================

# DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# 是否将日志写入文件
LOG_TO_FILE=true

# 日志文件存放目录
LOG_DIR=logs

# 文件日志默认记录 DEBUG；终端仍由 LOG_LEVEL 控制
LOG_FILE_LEVEL=DEBUG

# 单个日志文件达到该大小后轮转；保留最近的备份文件数量
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=7


# ==============================
# Agent 配置
# ==============================

AGENT_MAX_TURNS=10
COURSE_SUBJECT=math
COURSE_GRADE=high_school_1
